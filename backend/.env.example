# ─────────────────────────────────────────────────────────────
# Plantilla de variables de entorno del backend.
# Copia este archivo a `.env` y rellena con TUS claves reales.
#   cp .env.example .env
# `.env` está gitignoreado — NUNCA se commitea (aquí solo hay placeholders).
# ─────────────────────────────────────────────────────────────

# Entorno de ejecución: development | production
ENVIRONMENT=development

# Modelo — PRIMARIO: Anthropic (OBLIGATORIO para /transform). Sin la clave, /health
# y los tests (que mockean el LLM) funcionan igual, pero /transform falla con un mensaje claro.
# Consíguela en https://console.anthropic.com/ (API Keys).
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-5

# Clave de GOOGLE (AI Studio) — UNA sola clave cubre los dos roles de Gemini:
#   1. FALLBACK de la estructuración (opcional): si Anthropic falla al arrancar, PydanticAI
#      reintenta con Gemini DIRECTO. Sin esta clave el sistema funciona solo con Anthropic.
#   2. PERCEPCIÓN DE AUDIO (obligatoria para aceptar audio como documento fuente): Claude no
#      admite audio en su API, así que un modelo con entrada acústica nativa lo convierte en
#      una anotación estructurada (AudioEvidence) antes del pipeline. Sin la clave, subir un
#      audio da un 503 claro; el texto, el PDF y la imagen funcionan igual sin ella.
# Consíguela en https://aistudio.google.com/apikey
# GOOGLE_API_KEY=your-google-ai-studio-api-key-here
GOOGLE_MODEL=gemini-3.1-pro-preview            # fallback de estructuración (calidad Pro)
GOOGLE_PERCEPTION_MODEL=gemini-3.8-flash       # percepción de audio
# Tope de duración del audio subido, en minutos. NO es arbitrario: la anotación de la
# percepción crece con la duración (~3.550 tokens de salida por minuto de habla, medido) y el
# tope de salida del modelo son 65.536 tokens, o sea un techo real de ~18,5 min. A los 15 min
# queda margen para audio más denso (dos voces rápidas generan más segmentos por minuto).
# Si se excede, /transform responde 413 diciendo la duración y el límite.
MAX_AUDIO_MINUTES=15

# Verificación semántica de gráficos (2ª llamada al LLM). Ponla en false durante el
# desarrollo para ahorrar esa llamada extra en documentos con gráficos.
SEMANTIC_VERIFICATION_ENABLED=true

# Narración TTS (Hito 5g Parte 3) — OpenAI tts-1. Sin ella, /narration responde 503 y el
# frontend lo muestra (no reproductor mudo).
# Consíguela en https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova

# Generación de imágenes (ilustraciones 5h + presentación en slides 5j). La imagen tiene que
# entenderse SOLA: sin texto, y sin numeración ni marcas que remitan a una leyenda que no existe.
# Proveedor PRIMARIO: Gemini (usa la GOOGLE_API_KEY de más arriba, no hace falta clave nueva);
# RESPALDOS automáticos: Ideogram y después OpenAI gpt-image-1. Sin ninguno de los tres,
# /illustrations y /deck degradan sin imágenes (no rompen). Clave de Ideogram en https://ideogram.ai
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_IMAGE_ASPECT_RATIO=1:1
GOOGLE_IMAGE_SIZE=1K  # 1K = $0.067/imagen | 2K = $0.101
# IDEOGRAM_API_KEY=your-ideogram-api-key-here
IDEOGRAM_RENDERING_SPEED=QUALITY  # TURBO (~$0.03) | DEFAULT (~$0.06) | QUALITY (~$0.09)

# Pydantic Logfire — token de escritura del proyecto de observabilidad.
# Sin token, la app arranca igual y las trazas no se envían al dashboard.
LOGFIRE_TOKEN=your-logfire-write-token-here
LOGFIRE_SERVICE_NAME=multimodal-presenter-backend

# Telemetría de comportamiento (Hito 8). Se anexa a JSONL para análisis posterior (se exporta
# con scripts/export_telemetry.py). Déjalo vacío para usar la carpeta por defecto FUERA de
# OneDrive (LOCALAPPDATA en Windows). Ponlo en false para no escribir a disco (Logfire sigue).
TELEMETRY_ENABLED=true
# TELEMETRY_DIR=C:\ruta\a\tu\carpeta\de\telemetria
